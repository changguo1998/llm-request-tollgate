      "priority": 3,
      "models": [
        {
          "id": "deepseek-v4.1-flash",
          "priority": 20,
          "alias": "deepseek-v4.1-flash",
          "billing": "deepseek",
          "reasoning": true,
          "thinking_level_map": {
            "low": "low",
            "high": "high",
            "off": "none"
          },
          "context_window": 131072,
          "max_tokens": 65536
        },
        {
          "id": "glm-5-lite",
          "priority": 0,
          "alias": "glm-5-lite",
          "billing": "glm"
