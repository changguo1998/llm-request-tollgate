      "headers": {},
      "include_usage": true,
      "priority": 5,
      "models": [
        {
          "id": "deepseek-v4.1-flash",
          "priority": 10,
          "alias": "deepseek-v4.1-flash",
          "billing": "deepseek",
          "reasoning": true,
          "thinking_level_map": {
            "low": "low",
            "high": "high",
            "off": "none"
          },
          "context_window": 131072,
          "max_tokens": 65536
        },
        {
          "id": "qwen2.5-chat",
          "priority": 0,
          "alias": "qwen2.5-chat",
          "billing": "qwen"
        }
      ]
    },
    {
      "id": "group",
      "base_url": "https://example.invalid/v1",
      "auth_header": "Authorization",
      "key_env": "GROUP_API_KEY",
      "headers": {},
