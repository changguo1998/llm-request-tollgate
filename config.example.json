{
  "listen": "127.0.0.1:8787",
  "log_path": "var/requests.jsonl",
  "connect_sec": 10,
  "response_header_sec": 120,
  "stream_idle_sec": 240,
  "interval_sec": 0.5,
  "sem_wait_sec": 5,
  "queue_wait_sec": 10,
  "concurrency_lock_sec": 3600,
  "quota_lock_sec": 600,
  "breaker_lock_sec": 300,
  "lowperf_window_sec": 600,
  "lowperf_peak_max": 5,
  "lowperf_avg_max": 1,
  "lowperf_ttfb_max_sec": 30,
  "lowperf_lock_sec": 300,
  "lowperf_exempt": [],
  "retry_backoff_sec": [
    10,
    20,
    30
  ],
  "rate_window_sec": 3600,
  "block_window_sec": 35,
  "probe_enabled": true,
  "upstreams": [
    {
      "id": "ustc",
      "base_url": "https://example.invalid/v1",
      "auth_header": "Authorization",
      "key_env": "USTC_API_KEY",
      "headers": {},
      "include_usage": true,
      "models": [
        {
          "id": "deepseek-v4.1-flash",
          "billing_group": "deepseek"
        },
        {
          "id": "qwen2.5-chat",
          "billing_group": "qwen"
        }
      ]
    },
    {
      "id": "group",
      "base_url": "https://example.invalid/v1",
      "auth_header": "Authorization",
      "key_env": "GROUP_API_KEY",
      "headers": {},
      "include_usage": true,
      "models": [
        {
          "id": "deepseek-v4.1-flash",
          "billing_group": "deepseek"
        },
        {
          "id": "glm-5-lite",
          "billing_group": "glm"
        }
      ]
    }
  ],
  "aliases": {
    "deepseek-v4.1-flash": [
      [
        "group",
        "deepseek-v4.1-flash"
      ],
      [
        "ustc",
        "deepseek-v4.1-flash"
      ]
    ],
    "glm-5-lite": [
      [
        "group",
        "glm-5-lite"
      ]
    ],
    "qwen2.5-chat": [
      [
        "ustc",
        "qwen2.5-chat"
      ]
    ]
  }
}
