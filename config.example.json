{
  "listen": "127.0.0.1:8787",
  "log_path": "var/requests.jsonl",
  "connect_sec": 10,
  "response_header_sec": 120,
  "stream_idle_sec": 240,
  "interval_sec": 0.5,
  "sem_wait_sec": 5,
  "queue_wait_sec": 10,
  "concurrency_lock_sec": 3600,
  "quota_lock_sec": 600,
  "breaker_lock_sec": 300,
  "lowperf_window_sec": 600,
  "lowperf_peak_max": 5,
  "lowperf_avg_max": 1,
