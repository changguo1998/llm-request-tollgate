{
  "listen": "127.0.0.1:8787",
  "log_path": "var/requests.jsonl",
  "timeouts": {
    "connect_ms": 10000,
    "response_header_ms": 120000,
    "stream_idle_ms": 240000
  },
  "gate": {
    "interval_ms": 500,
    "sem_wait_ms": 5000,
    "queue_wait_ms": 10000,
    "concurrency_lock_ms": 3600000,
    "quota_lock_ms": 600000,
    "breaker_lock_ms": 300000,
    "retry_backoff_ms": [10000, 20000, 30000]
  },
  "probe": {
    "enabled": false,
    "scope": "next",
    "interval_sec": 900,
    "max_tokens": 8,
    "timeout_ms": 30000,
    "window": 5,
    "targets": [],
    "target_ttfb_ms": 0,
    "target_tps": 0,
    "switch_margin": 0.2
  },
  "upstreams": [
    {
      "id": "ustc",
      "base_url": "https://example.invalid/v1",
      "auth_header": "Authorization",
      "key_env": "USTC_API_KEY",
      "headers": {},
      "include_usage": true
    },
    {
      "id": "group",
      "base_url": "https://example.invalid/v1",
      "auth_header": "Authorization",
      "key_env": "GROUP_API_KEY",
      "headers": {},
      "include_usage": true
    }
  ],
  "aliases": {
    "deepseek-v4.1-flash": [
      [
        "ustc",
        "deepseek-v4.1-flash"
      ],
      [
        "group",
        "deepseek-v4.1-flash"
      ]
    ]
  }
}
