      "key_env": "USTC_API_KEY",
      "priority": 5,
      "models": [
        {
          "id": "deepseek-v4.1-flash",
          "priority": 10,
          "alias": "deepseek-v4.1-flash"
        },
        {
          "id": "deepseek-flash",
          "priority": 10,
