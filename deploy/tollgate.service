# llm-request-tollgate systemd 用户服务模板 (O1)。
# 安装: ./deploy/install_service.sh (会把 __ROOT__ 替换为仓库绝对路径)。
[Unit]
Description=llm-request-tollgate (LLM request proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
# 密钥只从环境变量来 (key_env), 不落盘。ExecStart 用交互式 bash (-i): bash 自己会
# source ~/.bashrc, 于是 fff 的 alias 与 aikey 全部就位, 再跑 `aikey all`
# (遍历 ~/.fff/keys/*.ai 逐个 fffenv) 把密钥加载进本进程环境, 最后 exec 代理本体。
# 不能写成 `bash -c 'source ~/.bashrc; ...'`: bashrc 开头有 "非交互就 return" 的守卫,
# 那种写法下 aikey 根本不会定义。加载结果 (Loaded xxx.ai) 进 journal:
#   ./deploy/tollgate.sh logs
ExecStart=/bin/bash -ic 'aikey all; exec __ROOT__/llm-request-tollgate -config __ROOT__/config.local.json'
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
