# llm-request-tollgate systemd 用户服务模板 (O1)。
# 安装: ./deploy/install_service.sh (会把 __ROOT__ 替换为仓库绝对路径)。
[Unit]
Description=llm-request-tollgate (LLM request proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
# 密钥只从环境变量来 (key_env), 不落盘。ExecStart 包一层 shell, 借用 fff 自己的
# `aikey all` (遍历 ~/.fff/keys/*.ai 逐个 fffenv) 把密钥加载进本进程环境:
# 先 source shellrc.sh 拿 FFF_HOME/FFF_PRIVATE/PATH, 再取定义 fffenv 与 aikey 的两个
# aliases.d 文件 -- 不直接 source ~/.bashrc, 因为它在非交互 shell 里会提前 return
# ("If not running interactively" 分支), 根本不会定义 aikey; 也不整份 source aliases.sh,
# 免得牵入依赖 fffz 的别名文件。加载结果 (Loaded xxx.ai) 会进 journal:
#   ./deploy/tollgate.sh logs
ExecStart=/bin/bash -c '. %h/fff/config/shellrc.sh; . %h/fff/config/aliases.d/25-env.sh; . %h/fff/config/aliases.d/10-ai.sh; aikey all; exec __ROOT__/llm-request-tollgate -config __ROOT__/config.local.json'
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
