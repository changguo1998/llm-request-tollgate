# llm-request-tollgate systemd 用户服务模板 (O1)。
# 安装: ./deploy/install_service.sh (会把 __ROOT__ 替换为仓库绝对路径)。
[Unit]
Description=llm-request-tollgate (LLM request proxy)
After=network-online.target
Wants=network-online.target
# fff-keys.service (在 ~/fff/config/systemd, 软链到 ~/.config/systemd/user) 负责把
# ~/.fff/keys/*.ai 里的密钥导入 systemd 用户环境; 缺了它, 重启后本服务会因 key_env
# 解析失败起不来。没有该 unit 时 Wants 只是警告, 不影响启动。
After=fff-keys.service
Wants=fff-keys.service

[Service]
Type=simple
WorkingDirectory=__ROOT__
# 密钥只从环境变量来 (key_env), 不落盘:
#   systemctl --user import-environment USTC_API_KEY GROUP_API_KEY ARKCP_API_KEY ARKAP_API_KEY
#   或 systemctl --user set-environment USTC_API_KEY=... (名字与配置里的 key_env 一致)
ExecStart=__ROOT__/llm-request-tollgate -config __ROOT__/config.local.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
